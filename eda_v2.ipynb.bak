    "df.to_csv('base.csv')\n",
    "\n",
    "for x in df['nome_produto'].unique():\n",
    "    # print(x)\n",
    "    d = df.filter(items=['nome_produto', 'quantia_item', 'preco_unit_item']).query(f'nome_produto == \"{x}\"').describe()\n",
    "    \n",
    "    std = d.at['std', 'preco_unit_item']\n",
    "    mean_p = d.at['mean', 'preco_unit_item']\n",
    "    mean_qtd = d.at['mean', 'quantia_item']\n",
    "    # print(std)\n",
    "    if std is pd.NA or std == 0:\n",
    "        # print(d)\n",
    "        print(std, x, mean_p, mean_qtd)\n",
