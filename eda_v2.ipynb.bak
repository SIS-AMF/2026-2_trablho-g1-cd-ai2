   "cell_type": "markdown",
   "id": "66424e5f",
   "metadata": {},
   "source": [
    "# Normalização dos tipos de dados, agrupamento de produtos e criação de features"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 184,
   "id": "2915e99c",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from skimpy import skim\n",
    "from sklearn.preprocessing import LabelBinarizer, LabelEncoder, OneHotEncoder\n",
    "\n",
    "labelBinarizer = LabelBinarizer()\n",
    "labelEncoder = LabelEncoder()\n",
    "oneHotEncoder  = OneHotEncoder()\n",
    "\n",
    "df = pd.read_csv('./studing/KalimentosFeirasVendas.csv')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 185,
   "id": "497550a4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "<class 'pandas.DataFrame'>\n",
