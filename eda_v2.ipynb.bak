       "'\\n# Transformação strings em numericos\\n\\ndf[\\'payment_mathod\\'] = labelEncoder.fit_transform(df[\\'payment_mathod\\'])\\ndf[\\'nome_produto\\'] = labelEncoder.fit_transform(df[\\'nome_produto\\'])\\ndf[\\'evento_nome\\'] = labelEncoder.fit_transform(df[\\'evento_nome\\'])\\ndf[\\'turno\\'] = labelEncoder.fit_transform(df[\\'turno\\'])\\n\\ndf.convert_dtypes()\\n\\n# Testes\\nfrom sklearn.cluster import KMeans\\nfrom sklearn.preprocessing import StandardScaler\\n\\nscaler = StandardScaler()\\n\\ndataset = df.drop(columns=[\\'pedido_data\\'])\\n\\n# dataset = scaler.fit(test)\\n\\npredict = KMeans(n_clusters=5).fit(dataset)\\n\\npredicao = predict.predict(dataset)\\n\\n\\ndf[\\'kmeans\\'] = predicao\\n\\nimport matplotlib.pyplot as plt\\nimport seaborn as sns\\n\\n# expo_inter = df.query(\\'evento_nome == \"EXPOINTER_2026\"\\')\\nplt.figure(figsize=(10, 6))\\nsns.scatterplot(data=df, x=\\'dia_horario\\', y=\\'nome_produto\\', hue=\\'kmeans\\')\\nplt.title(\\'Resultados\\')\\nplt.show()\\n'"
